# ==========================================
# ESYKRUSHI PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# Application
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=esykrushi_super_secret_production_key_2026_vtu
JWT_SECRET_KEY=esykrushi_jwt_secret_signing_token_998877

# Database Configuration (PostgreSQL / SQLite fallback)
# Production: postgresql://esyuser:esypassword@localhost:5432/esykrushi_db
DATABASE_URL=sqlite:///esykrushi.db

# Weather API (Open-Meteo works without key; OpenWeather optional)
OPENWEATHER_API_KEY=
WEATHER_PROVIDER=openmeteo

# AI Agricultural Assistant (Gemini / OpenAI / Fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Payment Gateway (Razorpay or Stripe simulated mode)
PAYMENT_GATEWAY=simulated
RAZORPAY_KEY_ID=rzp_test_esykrushi12345
RAZORPAY_KEY_SECRET=rzp_secret_key_mock_67890

# Email Notifications (SMTP configuration)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=esykrushi.notifications@gmail.com
MAIL_PASSWORD=app_specific_password_here

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Demonstration Mode
DEMO_MODE=true
